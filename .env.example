# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/myauth

MONGO_PORT=27017
MONGO_ROOT_USERNAME=your_mongodb_username
MONGO_ROOT_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb://your_mongodb_username:your_mongodb_password@localhost:27017/your_database?authSource=admin

# JWT Secrets (Generate strong random strings for production)
ACCESS_TOKEN_SECRET=your_strong_secret_key_change_this
REFRESH_TOKEN_SECRET=your_strong_secret_key_change_this
RESET_PASSWORD_TOKEN_SECRET=your_strong_secret_key_change_this

# Token Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@myauth.com

# Frontend URL (for email links)
CLIENT_URL=http://localhost:3000

# Kafka
KAFKA_PORT=9092
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=live-location-tracker
KAFKA_LOCATION_TOPIC=location-updates